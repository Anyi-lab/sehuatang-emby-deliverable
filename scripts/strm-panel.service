[Unit]
Description=115 to STRM Panel (strm_panel.py, port 5091)
Documentation=file:///root/clacky_workspace/sehuatang-emby-deliverable/scripts/strm_panel.md
# /mnt/g 是 strm 落点与清单根; docker 与 mdc 面板不是本服务的依赖
After=network-online.target mnt-g.mount
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/clacky_workspace/sehuatang-emby-deliverable/scripts
# WSL 冷启动时 drvfs 挂载可能慢于 systemd, 最多等 60s 出现 /mnt/g/srtm 再启, 超时也继续
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -d /mnt/g/srtm ] && break; sleep 2; done; exit 0'
ExecStart=/usr/bin/python3 /root/clacky_workspace/sehuatang-emby-deliverable/scripts/strm_panel.py --port 5091
Environment=PYTHONUNBUFFERED=1
# 与旧 nohup 方式同一个日志文件, 9080 面板「strm 面板日志」tab 照旧可读
StandardOutput=append:/var/log/strm_panel.log
StandardError=append:/var/log/strm_panel.log
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
